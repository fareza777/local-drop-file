<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">#F7F8FC</item>
        <item name="android:navigationBarColor">#F7F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowSplashScreenBackground">#3559E0</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_localdrop</item>
        <item name="android:windowSplashScreenAnimationDuration">350</item>
    </style>
    
    <style name="AppTheme.Splash" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#5054C9</item>
        <item name="android:navigationBarColor">#3D40A0</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
