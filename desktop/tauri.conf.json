{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalDrop Desktop",
  "version": "1.0.0",
  "identifier": "com.localdrop.desktop",
  "build": { "beforeBuildCommand": { "script": "npm run build", "cwd": "frontend" }, "frontendDist": "frontend/dist" },
  "app": { "windows": [{ "title": "LocalDrop Desktop", "width": 1180, "height": 780, "minWidth": 860, "minHeight": 600 }] },
  "bundle": { "active": true, "targets": ["nsis", "msi"], "shortDescription": "Transfer files between Android and Windows on your own network", "windows": { "nsis": { "installMode": "currentUser" }, "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }, "icon": ["icons/icon.ico"] }
}
